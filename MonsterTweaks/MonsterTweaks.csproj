<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MonsterTweaks</AssemblyName>
    <RootNamespace>MonsterTweaks</RootNamespace>
    <Version>0.4.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 公開化した Assembly-CSharp の private メンバーへアクセスするため -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 環境に合わせたパス(別の PC では書き換える) -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\REPO</GameDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\com.kesomannen.gale\repo\profiles\Repo MODs</ProfileDir>
    <ManagedDir>$(GameDir)\REPO_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(ProfileDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- private / internal メンバーを直接読めるように公開化してから参照する(実行時の DLL は元のまま) -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ManagedDir)\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(ManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(ManagedDir)\PhotonRealtime.dll" Private="false" />
    <Reference Include="Photon3Unity3D" HintPath="$(ManagedDir)\Photon3Unity3D.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- Thunderstore / Gale 用パッケージ情報 -->
  <PropertyGroup>
    <TsAuthor>shunm</TsAuthor>
    <TsName>$(AssemblyName)</TsName>
    <TsDescription>Host-side behaviour tweaks for 17 enemies plus per-enemy stun immunity and move speed for every enemy.</TsDescription>
    <TsDependencies>"BepInEx-BepInExPack-5.4.2305"</TsDependencies>
    <TsStageDir>$(MSBuildProjectDirectory)\obj\package</TsStageDir>
    <TsDistDir>$(MSBuildProjectDirectory)\..\dist</TsDistDir>
  </PropertyGroup>

  <!-- Debug ビルド: Gale がインポート済みの MOD フォルダへ DLL を上書きする(開発用)
       - Gale で ON / OFF できるように、自前のフォルダは作らない(先に dist の zip を Gale でインポートする)
       - Gale で OFF(ファイル名が .old)のときはコピーしない(勝手に ON に戻さない) -->
  <Target Name="CopyToGaleProfile" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(ProfileDir)')">
    <ItemGroup>
      <GaleEnabledDll Include="$(ProfileDir)\BepInEx\plugins\**\$(TargetFileName)" />
      <GaleDisabledDll Include="$(ProfileDir)\BepInEx\plugins\**\$(TargetFileName).old" />
    </ItemGroup>
    <Copy Condition="'@(GaleEnabledDll->Count())' == '1'" SourceFiles="$(TargetPath)" DestinationFolder="%(GaleEnabledDll.RootDir)%(GaleEnabledDll.Directory)" ContinueOnError="true" />
    <Message Condition="'@(GaleEnabledDll->Count())' == '1'" Importance="high" Text="-> @(GaleEnabledDll) を上書きしました" />
    <Message Condition="'@(GaleEnabledDll->Count())' == '0' And '@(GaleDisabledDll->Count())' != '0'" Importance="high" Text="-> Gale で OFF になっているのでコピーしませんでした" />
    <Warning Condition="'@(GaleEnabledDll->Count())' == '0' And '@(GaleDisabledDll->Count())' == '0'" Text="Gale に $(AssemblyName) がありません。Release ビルドで作った dist の zip を Gale の「ローカル MOD のインポート」で取り込んでください" />
    <Warning Condition="'@(GaleEnabledDll->Count())' &gt; '1'" Text="plugins に $(TargetFileName) が複数あります(@(GaleEnabledDll))。古いほうのフォルダを消してください" />
  </Target>

  <!-- Release ビルド: Gale の「ローカル MOD インポート」用 zip を dist に作る -->
  <Target Name="PackageForGale" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(TsStageDir)" />
    <MakeDir Directories="$(TsStageDir);$(TsDistDir)" />
    <WriteLinesToFile File="$(TsStageDir)\manifest.json" Overwrite="true"
                      Lines="{;  &quot;name&quot;: &quot;$(TsName)&quot;,;  &quot;author&quot;: &quot;$(TsAuthor)&quot;,;  &quot;version_number&quot;: &quot;$(Version)&quot;,;  &quot;website_url&quot;: &quot;&quot;,;  &quot;description&quot;: &quot;$(TsDescription)&quot;,;  &quot;dependencies&quot;: [$(TsDependencies)];}" />
    <Copy SourceFiles="$(TargetPath);Package\icon.png;Package\README.md" DestinationFolder="$(TsStageDir)" />
    <Delete Files="$(TsDistDir)\$(TsAuthor)-$(TsName)-$(Version).zip" />
    <ZipDirectory SourceDirectory="$(TsStageDir)" DestinationFile="$(TsDistDir)\$(TsAuthor)-$(TsName)-$(Version).zip" />
    <Message Importance="high" Text="-> $(TsDistDir)\$(TsAuthor)-$(TsName)-$(Version).zip を作成しました" />
  </Target>

</Project>
